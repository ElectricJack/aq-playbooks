{
  "purpose": "Judge a result that changed nothing",
  "entries": {
    "main": {
      "input": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "max_length": 4096
          },
          "project": {
            "type": "string",
            "max_length": 4096
          },
          "result": {
            "type": "string",
            "max_length": 4096
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "required": [
          "task",
          "project",
          "result",
          "version"
        ]
      },
      "outcomes": {
        "delivered": {
          "type": "null"
        },
        "returned": {
          "type": "null"
        },
        "ended": {
          "type": "null"
        },
        "failed": {
          "type": "null"
        }
      },
      "start": "read"
    }
  },
  "triggers": [
    {
      "id": "result-ready",
      "event": "aq.work.result_ready",
      "entry": "main",
      "input": {
        "op": "object",
        "fields": {
          "task": {
            "op": "ref",
            "root": "event",
            "path": [
              "task_id"
            ]
          },
          "project": {
            "op": "ref",
            "root": "event",
            "path": [
              "project_id"
            ]
          },
          "result": {
            "op": "ref",
            "root": "event",
            "path": [
              "result_id"
            ]
          },
          "version": {
            "op": "ref",
            "root": "event",
            "path": [
              "version"
            ]
          }
        }
      }
    }
  ],
  "steps": {
    "read": {
      "op": {
        "kind": "invoke",
        "command": "work.read",
        "bind": "read",
        "retry": null,
        "input": {
          "op": "object",
          "fields": {
            "subject": {
              "op": "object",
              "fields": {
                "id": {
                  "op": "ref",
                  "root": "input",
                  "path": [
                    "task"
                  ]
                },
                "revision": {
                  "op": "ref",
                  "root": "input",
                  "path": [
                    "version"
                  ]
                }
              }
            }
          }
        }
      },
      "edges": {
        "observed": "unchanged",
        "refused": "ended"
      },
      "on_error": "failed"
    },
    "unchanged": {
      "op": {
        "kind": "decide",
        "predicate": {
          "op": "eq",
          "left": {
            "op": "ref",
            "root": "read",
            "path": [
              "facts",
              "changed"
            ]
          },
          "right": {
            "op": "literal",
            "value": false
          }
        }
      },
      "edges": {
        "true": "ask",
        "false": "ended",
        "unknown": "failed"
      },
      "on_error": null
    },
    "ask": {
      "op": {
        "kind": "invoke",
        "command": "judgment.assess",
        "bind": "j",
        "retry": null,
        "input": {
          "op": "object",
          "fields": {
            "subject": {
              "op": "ref",
              "root": "read",
              "path": [
                "subject"
              ]
            },
            "question": {
              "op": "literal",
              "value": "Does the agent's conclusion show that the task's acceptance criteria are met without a change?"
            },
            "context": {
              "op": "object",
              "fields": {
                "items": {
                  "op": "array",
                  "items": [
                    {
                      "op": "object",
                      "fields": {
                        "label": {
                          "op": "literal",
                          "value": "Acceptance criteria"
                        },
                        "text": {
                          "op": "ref",
                          "root": "read",
                          "path": [
                            "facts",
                            "acceptance_criteria"
                          ]
                        }
                      }
                    },
                    {
                      "op": "object",
                      "fields": {
                        "label": {
                          "op": "literal",
                          "value": "Conclusion"
                        },
                        "text": {
                          "op": "ref",
                          "root": "read",
                          "path": [
                            "facts",
                            "conclusion"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            },
            "fields": {
              "op": "literal",
              "value": []
            },
            "flags": {
              "op": "literal",
              "value": [
                {
                  "id": "met",
                  "description": "The conclusion shows every acceptance criterion is met."
                }
              ]
            },
            "rationale_max_bytes": {
              "op": "literal",
              "value": 1024
            },
            "budget": {
              "op": "literal",
              "value": {
                "deadline_ms": 180000,
                "max_output_tokens": 1024
              }
            }
          }
        }
      },
      "edges": {
        "accepted": "await",
        "assessed": "ended",
        "failed": "ended",
        "refused": "ended"
      },
      "on_error": "failed"
    },
    "await": {
      "op": {
        "kind": "join",
        "members": [
          {
            "op": "ref",
            "root": "j",
            "path": []
          }
        ],
        "member_keys": [
          "c"
        ],
        "mode": "all",
        "accepted_outcomes": [
          "assessed"
        ],
        "deadline_ms": 180000,
        "remaining": "track",
        "bind": "answer"
      },
      "edges": {
        "completed": "met",
        "no_match": "ended",
        "timeout": "ended"
      },
      "on_error": "failed"
    },
    "met": {
      "op": {
        "kind": "decide",
        "predicate": {
          "op": "contains",
          "collection": {
            "op": "ref",
            "root": "answer",
            "path": [
              "c",
              "output",
              "flags"
            ]
          },
          "value": {
            "op": "literal",
            "value": "met"
          }
        }
      },
      "edges": {
        "true": "complete",
        "false": "send_back",
        "unknown": "failed"
      },
      "on_error": null
    },
    "complete": {
      "op": {
        "kind": "invoke",
        "command": "work.complete",
        "bind": "done",
        "retry": null,
        "input": {
          "op": "object",
          "fields": {
            "task": {
              "op": "ref",
              "root": "input",
              "path": [
                "task"
              ]
            },
            "result_id": {
              "op": "ref",
              "root": "input",
              "path": [
                "result"
              ]
            }
          }
        }
      },
      "edges": {
        "completed": "delivered",
        "refused": "failed"
      },
      "on_error": "failed"
    },
    "send_back": {
      "op": {
        "kind": "invoke",
        "command": "work.return",
        "bind": "back",
        "retry": null,
        "input": {
          "op": "object",
          "fields": {
            "task": {
              "op": "ref",
              "root": "input",
              "path": [
                "task"
              ]
            },
            "result_id": {
              "op": "ref",
              "root": "input",
              "path": [
                "result"
              ]
            },
            "reason": {
              "op": "literal",
              "value": "policy"
            },
            "detail": {
              "op": "literal",
              "value": "The result changed nothing and its conclusion does not show that the acceptance criteria are met."
            },
            "update_from_main": {
              "op": "literal",
              "value": false
            }
          }
        }
      },
      "edges": {
        "returned": "returned",
        "refused": "failed"
      },
      "on_error": "failed"
    },
    "delivered": {
      "op": {
        "kind": "return",
        "outcome": "delivered",
        "output": {
          "op": "literal",
          "value": null
        }
      },
      "edges": {},
      "on_error": null
    },
    "returned": {
      "op": {
        "kind": "return",
        "outcome": "returned",
        "output": {
          "op": "literal",
          "value": null
        }
      },
      "edges": {},
      "on_error": null
    },
    "ended": {
      "op": {
        "kind": "return",
        "outcome": "ended",
        "output": {
          "op": "literal",
          "value": null
        }
      },
      "edges": {},
      "on_error": null
    },
    "failed": {
      "op": {
        "kind": "return",
        "outcome": "failed",
        "output": {
          "op": "literal",
          "value": null
        }
      },
      "edges": {},
      "on_error": null
    }
  }
}
